# 데이터 프로바이더 선택: pykrx (개발/검증) | kis (한국투자증권) | kb (KB증권)
DATA_PROVIDER=pykrx

# 한국투자증권 KIS Developers REST API (GitHub Actions / 로컬 모두 가능)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_API_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_IS_PAPER=false

# KB증권 Open API (해외 IP 차단 -> 로컬 PC / 국내 리전 / Self-hosted Runner 전용)
KB_APP_KEY=
KB_APP_SECRET=
KB_API_BASE_URL=

# 주식 전용 텔레그램 봇 (코인 봇 토큰과 반드시 분리)
KOSPI_TELEGRAM_TOKEN=
KOSPI_TELEGRAM_CHAT_ID=

# 선택: 실행 모드 / 로깅
LOG_LEVEL=INFO
DRY_RUN=false
